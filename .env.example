# ============================================
# Configuration WANDA — copier en .env puis remplir
# ============================================

PORT=3000
NODE_ENV=development

# ------------------------------------------------------------
# Base de données
# ------------------------------------------------------------
# Deux moteurs sont gérés par le même code applicatif.
#
# S'il n'y a PAS de base à installer, il n'y a rien à configurer : supprimez
# simplement DATABASE_URL et l'application crée data/wanda.sqlite3 toute seule.
# C'est le mode par défaut, pensé pour developper et pour un hébergement
# persistant à faible trafic.
#
# DATABASE_URL n'est nécessaire que pour un vrai PostgreSQL (Neon, Railway,
# Supabase, ou un Postgres local) — typiquement pour absorber des pics de trafic,
# ou parce que l'hébergement ne fournit que des bases externes.
#
# ⚠️  Si la base est configurée mais injoignable, l'application REFUSE de
# démarrer au lieu de servir des données fictives. Un compteur faux en
# production est pire qu'une coupure visible.
#
# Exemple Neon : postgresql://user:password@ep-cool-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Local         : postgresql://postgres:postgres@localhost:5432/wanda
#
# DATABASE_URL=postgresql://localhost:5432/wanda_db

# Emplacement du fichier SQLite. Ignoré si DATABASE_URL est défini.
# Relatif au dossier du projet. Défaut : data/wanda.sqlite3
#
# ⚠️  Ce fichier contient toutes les publications, les réactions et les votes.
# Il est ignoré par git : ne le versionne jamais. Et assure-toi qu'il est bien
# sur un volume PERSISTANT. Sur un hébergement à système de fichiers éphémère
# (certains conteneurs, certaines fonctions serverless), il sera vidé à chaque
# redéploiement — dans ce cas, utilise DATABASE_URL.
# SQLITE_PATH=data/wanda.sqlite3

# ------------------------------------------------------------
# Sécurité — OBLIGATOIRE en production
# ------------------------------------------------------------
# Sel utilisé pour hasher les empreintes client (IP + token).
# Génère le tien avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# L'application REFUSE de démarrer en production sans cette variable : avec un
# sel devinable, les empreintes sont réversibles et l'anonymat tombe.
SALT_SECRET=wanda_secret_salt_237

# Nombre de proxys de confiance devant l'application (headers X-Forwarded-For).
# 1 = un proxy (hébergement classique). Ne jamais mettre `true` : un client
# pourrait alors forger son adresse IP et contourner le rate limiting.
# Laisse vide en local.
TRUST_PROXY=

# ------------------------------------------------------------
# Modération & quotas
# ------------------------------------------------------------

# Délai minimum entre deux publications, en minutes.
RATE_LIMIT_MINUTES=5

# ------------------------------------------------------------
# Emplacement du fichier .env
# ------------------------------------------------------------
# Ce fichier ne doit PAS être versionné (il est déjà ignoré par `.gitignore`).
# Il contient SALT_SECRET, qui sert à hasher les empreintes client : sans lui,
# les empreintes sont réversibles et l'anonymat du site tombe.
# Pour partager un exemple, on utilise le fichier `.env.example` versionné.
